{
  "name": "leaflet-theme-control",
  "version": "0.1.5",
  "description": "A Leaflet control for switching between visual themes (light, dark, grayscale, custom, etc.) using CSS filters",
  "main": "src/leaflet-theme-control.js",
  "module": "src/leaflet-theme-control.js",
  "types": "types/index.d.ts",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./src/leaflet-theme-control.js",
      "default": "./src/leaflet-theme-control.js"
    },
    "./src/leaflet-theme-control.css": "./src/leaflet-theme-control.css"
  },
  "files": [
    "src/**/*",
    "types/**/*",
    "README.md",
    "LICENSE.md"
  ],
  "keywords": [
    "leaflet",
    "dark-mode",
    "theme",
    "theme-editor",
    "accessibility",
    "css-filter",
    "map",
    "grayscale",
    "high-contrast",
    "filter",
    "leaflet-plugin"
  ],
  "author": "Kristjan ESPERANTO",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KristjanESPERANTO/leaflet-theme-control.git"
  },
  "bugs": {
    "url": "https://github.com/KristjanESPERANTO/leaflet-theme-control/issues"
  },
  "homepage": "https://KristjanESPERANTO.github.io/leaflet-theme-control/",
  "peerDependencies": {
    "leaflet": "^2.0.0-beta.5"
  },
  "devDependencies": {
    "@eslint/css": "^2.0.1",
    "@eslint/js": "^10.0.1",
    "@eslint/markdown": "^9.0.0",
    "@stylistic/eslint-plugin": "^6.0.1",
    "commit-and-tag-version": "^13.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-import-x": "^4.18.1",
    "eslint-plugin-jsdoc": "^65.5.0",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "leaflet": "^2.0.0-beta.5",
    "lint-staged": "^17.6.1",
    "prettier": "^3.10.1",
    "simple-git-hooks": "^2.14.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1"
  },
  "scripts": {
    "test": "npm run lint && npm run test:types && vitest run",
    "test:types": "tsc -p spec/types",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint && prettier --check .",
    "lint:fix": "eslint --fix && prettier --write .",
    "prepare": "simple-git-hooks",
    "release": "commit-and-tag-version"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*": [
      "eslint --fix",
      "prettier --write --ignore-unknown"
    ]
  },
  "allowScripts": {
    "simple-git-hooks@2.14.0": true
  }
}
